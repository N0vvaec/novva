# ===== Supabase =====
# URL del proyecto: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública "anon" (Settings > API). Se usa en el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave "service_role" (Settings > API). SOLO se usa en el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ===== WhatsApp =====
# Número de WhatsApp en formato internacional sin "+" (ej: 5215512345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ===== Redes sociales =====
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# ===== Admin =====
# Email del primer administrador (se crea con el script de seed)
NEXT_PUBLIC_ADMIN_EMAIL=
